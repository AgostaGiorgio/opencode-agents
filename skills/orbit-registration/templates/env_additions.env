# Orbit integration — add to .env and .env.example

# Full registration endpoint of the Orbit registry (include /api/v1/register).
# Leave unset to run the service without Orbit.
ORBIT_API_URL=https://orbit.example.dev/api/v1/register

# Public URL of this service. Must be an absolute http(s) URL, otherwise the
# Orbit registry rejects the registration with 422.
APP_URL=https://your-service.example.dev
